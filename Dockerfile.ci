ARG BASE_IMAGE_TAG=base
# 上游 xiaoyaliu/alist 基于 Alpine 3.17.10 minirootfs(python3 3.10,yt-dlp 需 3.11+):
# 系统层在此用 Alpine 3.24 等价重建(python3 3.14),文件层(data.zip 配置包/docker.version/updateall)从上游继承。
# 上游 apk 层内容参照其层历史:sqlite unzip bash curl gzip ripgrep busybox-extras nginx
# nginx-mod-http-js nginx-mod-http-lua apache2-utils jq tzdata + 时区 + rg 替换 grep hack
FROM xiaoyaliu/alist:latest AS xiaoya

FROM alpine:3.24
LABEL MAINTAINER="power721"
ARG TARGETPLATFORM
ARG INSTALL_FFMPEG=false
ARG INSTALL_ARIA2=false
ARG USER=alist
ARG UID=1001
ARG GID=1001

RUN apk add --no-cache \
        apache2-utils bash busybox-extras ca-certificates curl gzip jq \
        nginx nginx-mod-http-js nginx-mod-http-lua ripgrep sqlite tzdata unzip \
 && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && echo "Asia/Shanghai" > /etc/timezone \
 && rm -rf /tmp/* /var/cache/apk/* \
 && mv /usr/bin/rg /bin/grep

# 上游文件继承:/var/lib/data.zip 含 AList 初始 data.db 与小雅 CGI 订阅脚本
# (alist-tvbox init-xiaoya.sh 解包消费);docker.version 是小雅版本标记;updateall 为上游遗留工具
COPY --from=xiaoya /var/lib/data.zip /var/lib/data.zip
COPY --from=xiaoya /docker.version /docker.version
COPY --from=xiaoya /updateall /updateall

WORKDIR /opt/alist/

RUN addgroup -g ${GID} ${USER} && \
    adduser -D -u ${UID} -G ${USER} ${USER} && \
    mkdir -p /opt/alist/data

COPY --chmod=755 --chown=${UID}:${GID} /build/${TARGETPLATFORM}/alist ./
COPY --chmod=755 --chown=${UID}:${GID} entrypoint.sh /entrypoint.sh

RUN /entrypoint.sh version

ENV UMASK=022 RUN_ARIA2=${INSTALL_ARIA2}
VOLUME /opt/alist/data/
EXPOSE 5244 5245
CMD [ "/entrypoint.sh" ]
